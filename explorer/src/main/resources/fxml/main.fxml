<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.BorderPane?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1200.0"
            xmlns="http://javafx.com/javafx/21"
            fx:controller="com.tlcsdm.jvmexplorer.JvmExplorerController">
    <top>
        <MenuBar fx:id="menuBar"/>
    </top>
    <center>
        <SplitPane fx:id="splitPane" dividerPositions="0.23, 0.5">
            <items>
                <fx:include fx:id="runningJvms" SplitPane.resizableWithParent="false"
                            source="running_jvms.fxml"/>
                <fx:include fx:id="loadedClasses" SplitPane.resizableWithParent="false"
                            source="loaded_classes.fxml"/>
                <fx:include fx:id="currentClass" SplitPane.resizableWithParent="true"
                            source="current_class.fxml"/>
            </items>
        </SplitPane>
    </center>
</BorderPane>
